# Copy to backend.hcl and edit, then: terraform init -backend-config=backend.hcl
# backend.hcl is gitignored; it holds no secrets, only account-specific names.

bucket = "REPLACE-WITH-YOUR-STATE-BUCKET"
key    = "github-codecommit-mirror/terraform.tfstate"
region = "eu-west-1"

encrypt = true

# Native S3 state locking, so no DynamoDB table is needed. Terraform >= 1.10.
use_lockfile = true
